# FalkorDB. Local Docker uses 127.0.0.1:6379.
# FalkorDB Cloud uses the host and port from the cloud dashboard.
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_USERNAME=falkordb
FALKORDB_PASSWORD=
FALKORDB_GRAPH=SigmaCompanyBrain
FALKORDB_GRAPH_PREFIX=Sigma_

# Discord (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_GUILD_ID=

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Main investigation API
INVESTIGATION_API_URL=http://localhost:8000/investigate
INVESTIGATION_API_KEY=replace-with-a-long-random-key
API_TIMEOUT_SECONDS=120

# Context retrieval service (context retrieval/, port 8001)
CONTEXT_API_URL=http://127.0.0.1:8001
CONTEXT_API_KEY=replace-with-a-long-random-key
DISCORD_ALLOWED_CHANNEL_IDS=*
DISCORD_BOT_TOKEN=

# GitHub webhooks
GITHUB_WEBHOOK_SECRET=
