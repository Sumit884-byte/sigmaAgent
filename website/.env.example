# Configure one of these to enable the Discord CTAs. The invite URL may be a
# discord.gg invite, a discord.com/invite link, or a Discord OAuth2 install URL.
DISCORD_INVITE_URL=
# Alternatively, set the Discord application's public ID to generate an install
# link with view-channel, read-history, and send-message permissions.
DISCORD_APPLICATION_ID=

# Optional server-side URL for the live, read-only investigation workspace.
# Defaults to the local FastAPI service. Keep this variable unprefixed so it is
# never exposed to browser JavaScript.
SIGMAAGENT_API_URL=http://127.0.0.1:8000/investigate

# Required for production web access. Share this team access key only with
# authorized users; it is checked by the server and never sent to the backend.
SIGMAAGENT_WEB_ACCESS_TOKEN=

# Optional: set only if the API is configured to require this key.
# Do not use a NEXT_PUBLIC_ prefix for secrets.
INVESTIGATION_API_KEY=
